# Copy to Backend/.env for local development and replace both secrets.
APP_ENV=development
APP_NAME=AI Animation Studio API
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://studio_dev:local_dev_change_me@localhost:27017/?authSource=admin
MONGODB_DATABASE=ai_animation_studio
REDIS_URL=redis://localhost:6379/0
BLENDER_EXECUTABLE=blender
# Set one or more API keys. The worker falls back in this order.
MESHY_API_KEY=msy_0xE7hTLRIYIIuhg3S74M6cywMUvj7VcFGTz6
TRIPO_API_KEY=tsk_pk2Fkg7x5b9ql7-TMes7xxgjr_yoYsrl0_Gy8-f3nbE
RODIN_API_KEY=
RODIN_TIER=Gen-2.5-Low
MODEL_PROVIDER_ORDER=meshy,tripo,rodin
# Development starts a queue worker in the API process unless explicitly disabled.
RUN_WORKER_IN_API=true
STUDIO_STORAGE_DIR=./storage
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@aianimation.local
SMTP_USE_TLS=false
